{{- $pages := where site.RegularPages "Section" "blog" | first 30 -}}
{{- $self := (.OutputFormats.Get "rss").Permalink -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <language>fr-fr</language>
    <atom:link href="{{ $self }}" rel="self" type="application/rss+xml"/>
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Params.chapo | default .Description | default .Summary | plainify | htmlUnescape }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
